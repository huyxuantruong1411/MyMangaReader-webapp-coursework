# =============================================================================
# Manga Reader Web Application (QL-DocTruyen) — Environment Template
# Copy to `.env` (never commit `.env` with real secrets).
# The application starts safely in development mode WITHOUT external credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application & Runtime
# -----------------------------------------------------------------------------
APP_NAME="Manga Reader API"
APP_ENV="development"                     # development | test | staging | production
APP_VERSION="0.1.0"
APP_DEBUG="true"
LOG_LEVEL="INFO"                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"                         # json | console

# Backend HTTP server (port 8020 avoids collisions with local projects on 8000/8010)
API_HOST="127.0.0.1"
API_PORT="8020"
API_PREFIX="/api/v1"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend Vite configuration (also read from apps/web/.env if separated)
VITE_API_BASE_URL="/api/v1"
VITE_APP_TITLE="Manga Reader"

# -----------------------------------------------------------------------------
# Database Configuration
# Default dev/test mode uses local SQLite so startup requires zero DB setup.
# To connect to the existing local SQL Server 2022 `QL_DocTruyen` database:
#   DATABASE_BACKEND=mssql
#   DATABASE_URL="mssql+aioodbc://@localhost/QL_DocTruyen?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes&MARS_Connection=yes"
# -----------------------------------------------------------------------------
DATABASE_BACKEND="sqlite"                 # sqlite | mssql | postgres
DATABASE_URL="sqlite+aiosqlite:///./storage/local-dev/dev.sqlite3"
DATABASE_ECHO="false"
DATABASE_POOL_SIZE="5"
DATABASE_MAX_OVERFLOW="10"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# -----------------------------------------------------------------------------
# Security & Authentication (Phase 2+ Foundation)
# Replace JWT_SECRET_KEY with >=32 random bytes in staging/production!
# -----------------------------------------------------------------------------
JWT_SECRET_KEY="dev-only-insecure-secret-change-me-at-least-32-bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="14"
PASSWORD_HASH_ALGORITHM="argon2id"        # argon2id | bcrypt

# OTP Configuration (ADR-004: source sequence specifies 120s TTL)
OTP_TTL_SECONDS="120"
OTP_LENGTH="6"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"

# -----------------------------------------------------------------------------
# Cache / Rate Limiting (ADR-003, ADR-004)
# Options: memory (dev-fallback) | redis (reuses local Memurai on 127.0.0.1:6379)
# -----------------------------------------------------------------------------
CACHE_BACKEND="memory"                    # memory | redis
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_KEY_PREFIX="mreader:"

# -----------------------------------------------------------------------------
# Object Storage & Media Delivery (ADR-018: bucket + object_key identity)
# Options: local-dev (dev-fallback) | minio (reuses local MinIO on 127.0.0.1:9010)
# -----------------------------------------------------------------------------
STORAGE_BACKEND="local-dev"               # local-dev | minio | s3
LOCAL_STORAGE_ROOT="./storage/local-dev"
S3_ENDPOINT_URL="http://127.0.0.1:9010"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""                          # Set in .env for MinIO/S3 (e.g. local MinIO access key)
S3_SECRET_KEY=""                          # Set in .env for MinIO/S3
S3_ALLOWED_BUCKETS="manga-reader-media,manga-media"
S3_DEFAULT_BUCKET="manga-reader-media"
MEDIA_URL_MODE="proxy"                    # proxy | presigned
MEDIA_SIGNED_URL_TTL_SECONDS="300"
MEDIA_PUBLIC_BASE_URL="http://127.0.0.1:8020/api/v1/media"

# -----------------------------------------------------------------------------
# Email Delivery (Registration Verification & 3-Step Forgot Password OTP)
# Supports SMTP_HOST/SMTP_SERVER and SMTP_USERNAME/SMTP_ACCOUNT aliases.
# When SMTP_USERNAME/SMTP_PASSWORD are blank, AppContainer safely uses
# DevConsoleEmailAdapter; EMAIL_DEV_LOG_OTP=false prevents OTP leaks to clients.
# -----------------------------------------------------------------------------
EMAIL_BACKEND="dev-console"               # dev-console | smtp
SMTP_HOST="smtp.gmail.com"                # Alias: SMTP_SERVER
SMTP_PORT="587"
SMTP_USERNAME=""                          # Alias: SMTP_ACCOUNT (e.g. your-email@gmail.com)
SMTP_PASSWORD=""                          # Gmail App Password (16 chars, never commit real secrets)
SMTP_FROM_ADDRESS="noreply@manga-reader.local"
EMAIL_DEV_LOG_OTP="false"

# -----------------------------------------------------------------------------
# External Manga Source / ETL / CDC (Phase 3+ Foundation)
# -----------------------------------------------------------------------------
UPSTREAM_SOURCE_BASE_URL=""
UPSTREAM_WEBHOOK_SECRET=""
ETL_MAX_PACKAGE_BYTES="52428800"          # Project default: 50 MiB (configurable per ADR-015)

# -----------------------------------------------------------------------------
# Configurable NFR & Policy Defaults (ADR-015)
# IMPORTANT: Numeric values below are PROJECT DEFAULTS, NOT original Lab8 SLOs.
# Adjust via configuration after benchmarking or product confirmation.
# -----------------------------------------------------------------------------
CATALOG_DEFAULT_PAGE_SIZE="24"
CATALOG_MAX_PAGE_SIZE="100"
AUTOCOMPLETE_MAX_RESULTS="10"
READER_DEFAULT_PRELOAD_PAGES="3"
READER_MAX_PRELOAD_PAGES="10"
VALID_VIEW_THRESHOLD_SECONDS="15"         # Open product decision (#4)
VALID_VIEW_DEDUPE_WINDOW_SECONDS="300"    # Open product decision (#4)
PASSWORD_MIN_LENGTH="8"                   # Open product decision (#8)
AVATAR_MAX_BYTES="5242880"                # Project default: 5 MiB
COMMENT_MAX_LENGTH="2000"                 # Source Lab9 sequence limit
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="10"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="300"
API_RATE_LIMIT_PER_MINUTE="120"
