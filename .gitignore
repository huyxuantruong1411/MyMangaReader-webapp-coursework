# =============================================================================
# Manga Reader Web Application — .gitignore
# =============================================================================

# Environment & Secrets (NEVER commit real credentials)
.env
.env.local
.env.*.local
apps/api/.env
apps/web/.env
apps/web/.env.local
*.pem
*.key

# Local SQL Server live data files (attached to local MSSQLSERVER, ~73 MB)
data/*.mdf
data/*.ldf
data/*.ndf

# Large coursework data dump archives (~245 MB) — keep schema/scripts/docs tracked
docs/system_dump/data_jsonl_gz/

# Local development SQLite / storage adapter artifacts
*.db
*.sqlite
*.sqlite3
storage/local-dev/

# Python / uv / pytest / mypy / ruff
__pycache__/
*.py[cod]
*$py.class
.venv/
apps/api/.venv/
.uv-cache/
apps/api/.uv-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node / pnpm / Vite / Vitest
node_modules/
apps/web/dist/
packages/contracts/dist/
.pnpm-store/
*.tsbuildinfo
coverage/
.vite/

# Logs & temp files
*.log
npm-debug.log*
pnpm-debug.log*
tmp/
.tmp/

# OS & Editor artifacts
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
